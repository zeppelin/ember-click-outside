{
  "name": "ember-click-outside",
  "version": "6.1.1",
  "description": "A handy modifier for detecting click events fired outside an element",
  "keywords": [
    "ember-addon"
  ],
  "repository": "https://github.com/zeppelin/ember-click-outside",
  "license": "MIT",
  "author": "Gabor Babicz <gabor@gaborbabicz.com>",
  "files": [
    "addon-main.js",
    "dist",
    "types"
  ],
  "scripts": {
    "build": "rollup --config",
    "lint": "concurrently 'npm:lint:*(!fix)' --names 'lint:'",
    "lint:fix": "concurrently 'npm:lint:*:fix' --names 'fix:'",
    "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:js": "eslint . --cache",
    "lint:format": "prettier --check \"**/*.{js,gjs,ts,gts,mjs,mts,cjs,cts}\"",
    "lint:hbs:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
    "lint:js:fix": "eslint . --fix",
    "lint:format:fix": "prettier --check \"**/*.{js,gjs,ts,gts,mjs,mts,cjs,cts}\" --write",
    "start": "rollup --config --watch",
    "test": "echo 'A v2 addon does not have tests, run tests in test-app'",
    "prepack": "rollup --config"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.0.0",
    "ember-modifier": "^3.2.7 || ^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.17.0",
    "@babel/eslint-parser": "^7.18.2",
    "@embroider/addon-dev": "^3.0.0",
    "@rollup/plugin-babel": "^5.3.0",
    "concurrently": "^7.2.1",
    "ember-template-lint": "^4.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-ember": "^10.5.8",
    "eslint-plugin-n": "^15.6.1",
    "prettier": "^3.0.0",
    "prettier-plugin-ember-template-tag": "^2.1.3",
    "rollup": "^2.67.0",
    "rollup-plugin-copy": "^3.4.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.js",
    "app-js": {
      "./modifiers/on-click-outside.js": "./dist/_app_/modifiers/on-click-outside.js"
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": {
      "types": "./types/*.d.ts",
      "default": "./dist/*.js"
    },
    "./addon-main.js": "./addon-main.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "types/*"
      ]
    }
  }
}
